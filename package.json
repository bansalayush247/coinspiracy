{
  "name": "byzantine-council",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p e2e/tsconfig.json && tsc -p scripts/tsconfig.json",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm run test",
    "smoke": "tsx --conditions=source e2e/smoke.ts",
    "offline": "tsx --conditions=source e2e/offline.ts",
    "beach": "tsx --conditions=source e2e/beach.ts",
    "reef": "tsx --conditions=source e2e/reef.ts",
    "peaks": "ARENA=peaks tsx --conditions=source e2e/reef.ts",
    "academy": "tsx --conditions=source e2e/academy.ts",
    "loadtest": "tsx --conditions=source scripts/loadtest/run.ts",
    "dev:islands": "tsx --conditions=source scripts/dev/all-islands.ts",
    "beach:phone": "BEACH_VIEWPORT=phone tsx --conditions=source e2e/beach.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "playwright-core": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
