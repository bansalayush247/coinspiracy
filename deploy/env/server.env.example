# /etc/byzantine-council/server.env (root:root, mode 0600). Every variable the game server reads.

NODE_ENV=production
# Loopback only: nginx on the same host is the only way in.
HOST=127.0.0.1
PORT=2567
# The page origin that may open game sockets and call the API.
ALLOWED_ORIGINS=https://play.example.org
# nginx sets X-Real-IP; only this address may.
TRUSTED_PROXIES=127.0.0.1
# Concurrent seats per network. Schools and households share an address, so keep it generous.
MAX_SEATS_PER_IP=16
# Plain-text tip height over https, or "off" to estimate from the clock.
BLOCK_HEIGHT_URL=https://mempool.space/api/blocks/tip/height
LOG_LEVEL=info
# Practice bots the host can add to a lobby: on or off.
BOTS=on

# Guest profiles. Generate the secret with: openssl rand -base64 48
DATABASE_URL=postgresql://bcouncil:CHANGE_ME@127.0.0.1:5432/bcouncil
SESSION_SECRET=CHANGE_ME_TO_48_RANDOM_BYTES_BASE64_ENCODED_XXXXXXXXXXXX
# During a secret rotation, the old secret goes here for 30 days so existing cookies keep working.
SESSION_SECRET_PREVIOUS=

# Several server processes (optional). All three are needed together in production.
# REDIS_URL=rediss://:password@redis.internal:6380/0
# SCALING_KEY_SECRET=
# PUBLIC_ADDRESS=play.example.org/colyseus/s1

# Who may frame the game (optional): https origins, comma-separated. Unset keeps frame-ancestors 'none'.
# Render the same list into nginx with deploy/scripts/frame-ancestors.sh. See docs/deploy.md.
# FRAME_ANCESTORS=https://discord.com,https://*.discordsays.com

# Playtest feedback (optional): an absolute folder for daily feedback-YYYY-MM-DD.jsonl files. Unset means no feedback
# route. Under systemd only /var/lib/byzantine-council is writable. See docs/playtest.md.
# FEEDBACK_DIR=/var/lib/byzantine-council/feedback

# Discord Activity sign-in (optional). All three or none; a partial setup answers 503 on the token route only.
# Add https://<DISCORD_CLIENT_ID>.discordsays.com to ALLOWED_ORIGINS as well.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# Maps Discord users to guest profiles; generate with openssl rand -base64 48 and never rotate it.
# DISCORD_PROFILE_SECRET=
